# ── Survey raw data (from external sources, refreshable) ──────────────────────
# SPSS files from ABS, LBS, Afrobarometer
*.sav
# R binary data files (generated outputs or external data)
*.RData
# External questionnaire documents
*.docx
# WVS parquet files (downloaded from WVS website)
data/wvs/raw/
# Afrobarometer raw data
data/afro/
# KGSS raw data
data/kgss/
# External reference datasets (V-Dem, OWID, CLEA, etc.)
data/external/
# V-Dem raw data (large RDS files, refreshable from V-Dem website)
data/v-dem/raw/**/*.rds
data/marpor/raw/**/*.rds
# OECD DAC bulk extracts (141 MB across DAC2A + DAC3A, refreshable from the SDMX
# endpoint recorded in each folder's RETRIEVED.txt). The provenance files —
# RETRIEVED.txt and the cl_area_org.csv codelist — ARE tracked, so a fresh clone
# can reproduce the download exactly without carrying the payload.
data/oecd-dac/raw/**/dac2a_*.csv
data/oecd-dac/raw/**/dac3a_*.csv

# ── Pipeline outputs (generated, not source data) ─────────────────────────────
# Per-wave and final harmonized datasets
data/processed/*.rds
data/processed/*.parquet
data/processed/*.csv
data/interim/*.rds
data/interim/*.parquet
data/interim/*.csv
# Top-level outputs (ABS master files, old one-off outputs)
outputs/*.rds
outputs/*.parquet
# Survey-specific output directories
outputs/lbs/
outputs/wvs/
outputs/afro/
outputs/kamos/
outputs/kgss/
# Prospector outputs (regenerated by runner scripts — keep .md memos)
outputs/prospecting/**/*.csv
outputs/prospecting/**/*.png
outputs/prospecting/**/*.rds

# ── Tool artifacts ─────────────────────────────────────────────────────────────
.here
.serena/

# PDF outputs
*.pdf
!outputs/figures/*.pdf
# Source codebooks/handbooks shipped with a raw release. The blanket *.pdf rule
# above was silently excluding these, even though the policy note at the foot of
# this file says codebooks are tracked. The MARPOR data request specifically
# requires the CMP coding handbook be stored alongside the release.
#
# ⚠️ Deliberately NARROW — scoped to the two non-survey sources added for
# paper 25, not a blanket `!data/*/raw/**/*.pdf`. That broader rule would pull in
# 261 files / 535 MB of questionnaires and methods reports across every survey.
# Tracking those may well be right (the policy note implies it), but it is a
# separate decision with real repo-size consequences — not a side effect of a
# MARPOR commit.
!data/marpor/raw/**/*.pdf
!data/des/raw/**/*.pdf

# R session artifacts
.Rapp.history

# hwp5html extraction artifacts (intermediate; extracted .txt is the kept output)
data/*/questionnaires/extracted_html/

# Claude Code local settings (settings.local.json holds machine-specific permissions)
.claude/

# ── Raw survey microdata: statistical binaries only ──────────────────────────
# `.sav` is already excluded above (line ~159); `.dta` is the same thing in
# Stata's format and was slipping through — 22 files, ~278 MB, including three
# Arab Barometer waves at 77-91 MB each.
#
# Deliberately NARROW. Raw `.csv` releases are NOT ignored: re-pulling them from
# the barometer sites is slow, and unlike .sav/.dta they are the plain-text
# source many loaders read. Questionnaires, codebooks and provenance notes are
# tracked too. Only the redundant statistical binaries are excluded.
*.dta

# ── Regenerable per-survey outputs ───────────────────────────────────────────
# Rebuilt by 2_harmonize_all.R + 99_create_final_dataset.R. Matches the existing
# outputs/{lbs,wvs,afro,kamos,kgss} rules.
outputs/abs/
outputs/arab-barometer/
outputs/gcb/
outputs/ipus/
outputs/kinu/
outputs/kipa-corruption/
outputs/klosa/
outputs/prospecting/
